# syntax=docker/dockerfile:1
# Preserve the accepted Stage runtime and its native model stack.
FROM registry.ttd/pymss-webui/runtime@sha256:38fcad0bdf834a1d2ad22a34e9c87bb6e7bf00f75aa46c744527f23f7d7914e8
ARG SOURCE_REV
COPY --link deploy/song-studio/runtime /app/studio_runtime
COPY --link .source-commit /opt/song-studio-source-commit
LABEL org.opencontainers.image.source="https://github.com/FC-TTD/pymss-webui" org.opencontainers.image.revision="${SOURCE_REV}"
